<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev.controllers.TraitementController"
      stylesheets="@/styles/theme2.css" spacing="10" prefWidth="800" prefHeight="600">

    <!-- Title -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Text text="Gestion des Traitements" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouveau Traitement" onAction="#ouvrirNouveauTraitement" styleClass="add-button"/>
        <Button text="Exporter" onAction="#exporterTraitements" styleClass="action-button"/>
        <Text text="Admin Dashboard" styleClass="dashboard-text"/>
    </HBox>

    <!-- Form for adding/editing treatments -->
    <VBox spacing="15" styleClass="form-container">
        <HBox spacing="10">
            <Label text="Prescription:" styleClass="form-label" minWidth="100"/>
            <ComboBox fx:id="prescriptionComboBox" promptText="Sélectionner une prescription" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Médicament:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="medicamentField" promptText="Médicament" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Dose:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="doseField" promptText="Dose" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Description:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="descriptionField" promptText="Description" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Statut:" styleClass="form-label" minWidth="100"/>
            <ComboBox fx:id="statutField" promptText="Sélectionner un statut" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Date:" styleClass="form-label" minWidth="100"/>
            <DatePicker fx:id="datePicker" promptText="Sélectionner une date" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Complété:" styleClass="form-label" minWidth="100"/>
            <CheckBox fx:id="completedCheckBox"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Archivé:" styleClass="form-label" minWidth="100"/>
            <CheckBox fx:id="archivedCheckBox"/>
        </HBox>
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#ajouterTraitement" styleClass="action-button"/>
            <Button fx:id="modifierButton" text="Modifier" onAction="#modifierTraitement" styleClass="action-button"/>
            <Button fx:id="supprimerButton" text="Supprimer" onAction="#supprimerTraitement" styleClass="action-button"/>
            <Button fx:id="archiverButton" text="Archiver" onAction="#archiverTraitement" styleClass="action-button"/>
            <Button text="Réinitialiser" onAction="#reinitialiserChamps" styleClass="action-button"/>
        </HBox>
    </VBox>

    <!-- Search and Filter Section -->
    <HBox spacing="20" styleClass="search-bar">
        <ComboBox fx:id="filterComboBox" promptText="Tout" prefWidth="150"/>
        <TextField fx:id="filterField" promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Card view for treatments -->
    <ScrollPane fitToHeight="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="traitementsContainer" hgap="15" vgap="15" prefWrapLength="1000" styleClass="card-container">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>

    <!-- OCR Section -->
    <VBox spacing="10">
        <Button text="Extraire Texte (OCR)" onAction="#extraireTexteAvecOCR" styleClass="action-button"/>
        <TextArea fx:id="ocrResultArea" promptText="Résultat OCR" editable="false" prefHeight="100"/>
    </VBox>

    <!-- Statistics Panel -->
    <VBox spacing="10" styleClass="stats-panel">
        <Label text="Statistiques" styleClass="form-label"/>
        <TextArea fx:id="statsLabel" editable="false" wrapText="true" prefHeight="100"/>
    </VBox>

    <!-- Padding for the entire VBox -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>