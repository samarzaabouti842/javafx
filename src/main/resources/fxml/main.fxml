<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.layout.Region?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Pidev.controllers.MainController"
      stylesheets="@../styles/dashboard.css"
      styleClass="main-container"
      spacing="20"
      alignment="CENTER">

    <!-- Navigation Bar -->
    <HBox styleClass="navbar" prefHeight="60">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>
        <Label text="MaSanté" styleClass="navbar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Aide" onAction="#handleAide" styleClass="nav-button"/>
        <Button text="Déconnexion" onAction="#handleDeconnexion" styleClass="nav-button, logout-button"/>
    </HBox>

    <Text text="Gestion des Prescriptions Médicales"
          styleClass="main-title"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Gérer les Prescriptions"
                onAction="#handlePrescription"
                styleClass="menu-button"/>

        <Button text="Gérer les Traitements"
                onAction="#handleTraitement"
                styleClass="menu-button"/>

        <Button text="Vue Patient"
                onAction="#handlePatient"
                styleClass="menu-button"/>
    </HBox>
</VBox>