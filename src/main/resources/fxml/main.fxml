<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev.controllers.MainController"
      stylesheets="@../styles/theme.css" alignment="CENTER" spacing="20">

    <!-- Navigation Bar -->
    <HBox styleClass="navbar" prefHeight="60">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>
        <Label text="MaSanté" styleClass="navbar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Aide" onAction="#handleAide" styleClass="nav-button"/>
        <Button text="Déconnexion" onAction="#handleDeconnexion" styleClass="nav-button, logout-button"/>
    </HBox>

    <!-- Main Content -->
    <VBox styleClass="main-content" alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
        <Text text="Système de Gestion des Traitements" styleClass="main-title"/>
        <Text text="Bienvenue dans votre espace de gestion" styleClass="subtitle"/>
        <HBox spacing="20">
            <Button text="Vue Patient" onAction="#handlePatient" styleClass="action-button"/>
            <Button text="Prescription" onAction="#handlePrescription" styleClass="action-button"/>
            <Button text="Traitement" onAction="#handleTraitement" styleClass="action-button"/>
        </HBox>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="footer" prefHeight="40">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>
        <Text text="2025 - Tous droits réservés" styleClass="footer-text"/>
    </HBox>
</VBox>