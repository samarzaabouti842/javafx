<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev.controllers.PrescriptionController"
      stylesheets="@/styles/theme2.css" spacing="10" prefWidth="800" prefHeight="600">

    <!-- Title -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Text text="Gestion des Prescriptions" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouvelle Prescription" onAction="#ouvrirNouvellePrescription" styleClass="add-button"/>
        <Text text="Admin Dashboard" styleClass="dashboard-text"/>
    </HBox>

    <!-- Form for adding/editing prescriptions -->
    <VBox spacing="15" styleClass="form-container">
        <HBox spacing="10">
            <Label text="Date Début:" styleClass="form-label" minWidth="100"/>
            <DatePicker fx:id="dateDebutPicker" promptText="Sélectionner la date de début" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Date Fin:" styleClass="form-label" minWidth="100"/>
            <DatePicker fx:id="dateFinPicker" promptText="Sélectionner la date de fin" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Adresse:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="adresseField" promptText="Adresse" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Gmail:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="gmailField" promptText="Gmail" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Patient ID:" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="patientIdField" promptText="ID du patient" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#ajouterPrescription" styleClass="action-button"/>
            <Button fx:id="modifierButton" text="Modifier" onAction="#modifierPrescription" styleClass="action-button"/>
            <Button fx:id="supprimerButton" text="Supprimer" onAction="#supprimerPrescription" styleClass="action-button"/>
            <Button text="Réinitialiser" onAction="#reinitialiserChamps" styleClass="action-button"/>
            <Button text="Changer Statut" onAction="#changerStatut" styleClass="action-button"/>
        </HBox>
    </VBox>

    <!-- Search and Filter Section -->
    <HBox spacing="20" styleClass="search-bar">
        <ComboBox fx:id="filterComboBox" promptText="Tout" prefWidth="150"/>
        <TextField fx:id="filterField" promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="sortField" promptText="Trier par" prefWidth="150"/>
        <ComboBox fx:id="sortOrder" promptText="Ordre" prefWidth="150"/>
        <Button text="Trier" onAction="#trierPrescriptions" styleClass="action-button"/>
    </HBox>

    <!-- Card view for prescriptions (using FlowPane) -->
    <ScrollPane fitToHeight="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="prescriptionsContainer" hgap="15" vgap="15" prefWrapLength="1000" styleClass="card-container">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>

    <!-- Pagination and Actions -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Précédent" onAction="#pagePrecedente" styleClass="action-button"/>
        <Label fx:id="pageLabel" text="Page 1/1"/>
        <Button text="Suivant" onAction="#pageSuivante" styleClass="action-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="archiveToggle" text="Voir Archivés" onAction="#basculerVueArchivées"/>
        <Button fx:id="archiveButton" text="Archiver Expirés" onAction="#archiverPrescriptionsExpirées" styleClass="action-button"/>
        <Button text="Exporter" onAction="#exporterPrescriptions" styleClass="action-button"/>
        <Button text="Statistiques" onAction="#afficherStatistiques" styleClass="action-button"/>
    </HBox>

    <!-- Statistics Panel -->
    <VBox fx:id="statsPanel" spacing="10" visible="false" styleClass="stats-panel">
        <Label text="Statistiques" styleClass="form-label"/>
        <Label fx:id="statsLabel" wrapText="true"/>
        <Button text="Masquer Statistiques" onAction="#cacherStatistiques" styleClass="action-button"/>
    </VBox>

    <!-- Padding for the entire VBox -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>